---
const links = [
  { href: '/tutors',    text: 'Tutors' },
  { href: '/subjects',  text: 'Subjects' },
  { href: '/pricing',   text: 'Pricing' },
  { href: '/resources', text: 'Resources' },
  { href: '/faq',       text: 'FAQ' },
  { href: '/contact',   text: 'Contact' },
]
const current = Astro.url.pathname
---
<header class="site-nav">
  <div class="container nav-inner">
    <a href="/" class="wordmark">StudyHall<span class="dot">.</span></a>
    <nav>
      {links.map((l) => (
        <a href={l.href} class:list={{ active: current.startsWith(l.href) }}>{l.text}</a>
      ))}
      <a href="/book" class="btn btn-small">Book a Session</a>
    </nav>
  </div>
</header>