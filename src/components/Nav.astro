---
import { href } from '../lib/link'
const links = [
  { path: '/tutors', text: 'Tutors' },
  { path: '/subjects', text: 'Subjects' },
  { path: '/pricing', text: 'Pricing' },
  { path: '/resources', text: 'Resources' },
  { path: '/faq', text: 'FAQ' },
  { path: '/contact', text: 'Contact' },
]
const current = Astro.url.pathname
---
<header class="site-nav">
  <div class="container nav-inner">
    <a href={href('/')} class="wordmark">Brantford Tutors<span class="dot">.</span></a>
    <nav>
      {links.map((l) => (
        <a href={href(l.path)} class:list={{ active: current.startsWith(href(l.path)) }}>{l.text}</a>
      ))}
      <a href={href('/book')} class="btn btn-small">Book a Session</a>
    </nav>
  </div>
</header>