---
import Layout from '../../layouts/Layout.astro'
import { getCollection, render } from 'astro:content'
import { href } from '../../lib/link'

export async function getStaticPaths() {
  const subjects = await getCollection('subjects')
  return subjects.map((s) => ({ params: { slug: s.id }, props: { subject: s } }))
}

const { subject } = Astro.props
const { Content } = await render(subject)

const teaching = (await getCollection('tutors'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((t) => t.data.subjects.some((s) => s === subject.id))
---
<Layout title={`${subject.data.title} Tutoring · Brantford Tutors`}>
  <section class="container">
    <a href={href('/subjects')} class="back-link">← All subjects</a>

    <div class="subject-header">
      <div class="subject-header-text">
        <p class="num" style="font-size: 3rem;">{String(subject.data.order).padStart(2, '0')}</p>
        <h1>{subject.data.title}</h1>
        <p class="lead" style="margin-top: .8rem;">{subject.data.tagline}</p>
      </div>

      {subject.data.photo && (
        <img
          src={subject.data.photo}
          alt={subject.data.title}
          class="subject-hero"
          loading="eager"
        />
      )}
    </div>

    <div class="split" style="margin-top: 2.5rem;">
      <div>
        <div class="prose"><Content /></div>

        <h2 style="margin-top: 2.5rem;">What we cover</h2>
        <ul class="topics">
          {subject.data.topics.map((topic) => <li>{topic}</li>)}
        </ul>

        <div style="margin-top: 2rem; display: grid; gap: .8rem;">
          <p><strong>Good for:</strong> {subject.data.levels}</p>
          <p><strong>What to bring:</strong> {subject.data.bring}</p>
        </div>

        <div style="margin-top: 2.5rem;">
          <a href={href(`/book?subject=${subject.id}`)} class="btn">Book {subject.data.title}</a>
        </div>
      </div>

      <aside>
        <p class="section-label">Your tutors for {subject.data.title}</p>
        <div class="mini-tutors" style="grid-template-columns: 1fr;">
          {teaching.map((t) => (
            <a href={href(`/tutors/${t.id}`)} class={`mini-tutor ac-${t.data.accent}`}>
              {t.data.photo ? (
                <img src={t.data.photo} alt={t.data.name} class="avatar avatar-sm" loading="lazy" />
              ) : (
                <div class="avatar avatar-sm">{t.data.name.charAt(0)}</div>
              )}
              <div>
                <strong>{t.data.name}</strong>
                <p class="meta">{t.data.blurb}</p>
              </div>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .subject-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .subject-header-text {
    flex: 1;
    min-width: 0;
  }

  .subject-hero {
    width: 320px;
    flex-shrink: 0;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  @media (max-width: 800px) {
    .subject-header {
      flex-direction: column;
      align-items: stretch;
    }

    .subject-hero {
      width: 100%;
      max-width: 420px;
    }
  }
</style>