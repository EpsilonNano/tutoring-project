---
import Layout from '../../layouts/Layout.astro'
import { getCollection, render } from 'astro:content'
import { href } from '../../lib/link'

export async function getStaticPaths() {
  const subjects = await getCollection('subjects')
  return subjects.map((s) => ({ params: { slug: s.id }, props: { subject: s } }))
}

const { subject } = Astro.props
const { Content } = await render(subject)

const teaching = (await getCollection('tutors'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((t) => t.data.subjects.some((s) => s === subject.id))
---
<Layout title={`${subject.data.title} Tutoring · Brantford Tutors`}>
  
  <!-- HERO: Centered, airy -->
  <section class="subject-hero container">
    <a href={href('/subjects')} class="back-link">← All subjects</a>
    <h1>{subject.data.title}</h1>
    <p class="subject-tagline">{subject.data.tagline}</p>
    
    {subject.data.photo && (
      <img
        src={subject.data.photo}
        alt={subject.data.title}
        class="subject-hero-img"
        loading="eager"
      />
    )}
  </section>

  <!-- BODY -->
  <section class="subject-body container">
    <div class="prose"><Content /></div>

    <h2>What we cover</h2>
    <ul class="topic-list">
      {subject.data.topics.map((topic) => (
        <li>{topic}</li>
      ))}
    </ul>

    <p class="subject-meta">Good for {subject.data.levels}.</p>
    <p class="subject-meta">{subject.data.bring}</p>
  </section>

  <!-- TUTORS -->
  <section class="subject-tutors-section">
    <div class="container">
      <h2>Your {subject.data.title} tutors</h2>
      <div class="tutors-grid">
        {teaching.map((t) => (
          <a href={href(`/tutors/${t.id}`)} class="tutor-card">
            {t.data.photo ? (
              <img src={t.data.photo} alt={t.data.name} class="avatar avatar-sm" loading="lazy" />
            ) : (
              <div class="avatar avatar-sm">{t.data.name.charAt(0)}</div>
            )}
            <div class="tutor-info">
              <strong>{t.data.name}</strong>
              <p>{t.data.blurb}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="subject-cta-section">
    <div class="container cta-inner">
      <h2>Want help with {subject.data.title}?</h2>
      <a href={href(`/book?subject=${subject.id}`)} class="btn btn-big">Book {subject.data.title}</a>
    </div>
  </section>
</Layout>

<style>
  /* --- Hero Section --- */
  .subject-hero {
    text-align: center;
    padding-top: 2rem;
  }
  
  .subject-hero .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    text-decoration: none;
    color: var(--muted);
    font-weight: 700;
    font-size: .9rem;
  }
  
  .subject-hero h1 {
    font-size: clamp(2.8rem, 6vw, 4rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
  }
  
  .subject-tagline {
    font-size: 1.25rem;
    color: var(--muted);
    max-width: 600px;
    margin: 1rem auto 0;
    line-height: 1.5;
  }
  
  .subject-hero-img {
    width: 100%;
    max-width: 900px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 24px;
    margin: 3rem auto 0;
    display: block;
    background: color-mix(in srgb, var(--border) 20%, transparent);
  }

  /* --- Body Content --- */
  .subject-body {
    max-width: 760px;
    padding-block: 4rem;
  }
  
  .subject-body .prose {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--ink);
  }

  .topic-list {
    list-style: disc;
    padding-left: 1.4rem;
    margin: 1rem 0 2rem 0;
    display: grid;
    gap: 0.4rem;
  }

  .subject-meta {
    color: var(--muted);
    margin: 0.6rem 0;
  }

  /* --- Tutors Section (no borders) --- */
  .subject-tutors-section {
    background: var(--paper);
    padding-block: 4rem;
    /* borders removed */
  }
  
  .subject-tutors-section h2 {
    font-size: clamp(1.8rem, 3vw, 2.2rem);
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
  }
  
  .tutors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  
  .tutor-card {
    display: flex;
    gap: 1rem;
    align-items: center;
    background: var(--paper-raised);
    border-radius: 16px;
    padding: 1.5rem;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .tutor-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }
  
  .tutor-info strong {
    display: block;
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }
  
  .tutor-info p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.4;
  }

  /* --- CTA Section --- */
  .subject-cta-section {
    padding-block: 5rem;
    text-align: center;
  }
  
  .cta-inner {
    max-width: 600px;
    margin: 0 auto;
  }
  
  .subject-cta-section h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  /* --- Responsive --- */
  @media (max-width: 640px) {
    .subject-hero-img {
      border-radius: 16px;
    }
  }
</style>