---
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { href } from '../../lib/link'

const subjects = (await getCollection('subjects')).sort((a, b) => a.data.order - b.data.order)
const tutors = (await getCollection('tutors')).sort((a, b) => a.data.order - b.data.order)
const tutorsFor = (id: string) => tutors.filter((t) => t.data.subjects.some((s) => s === id))
---

<Layout
  title="Subjects · Brantford Tutors"
  description="Math, Science, French, Coding, and Chess tutoring from students who just aced these courses."
>
  <section class="container">
    <p class="section-label">What we teach</p>
    <h1>Five subjects, taught by students who know them well.</h1>

    <div style="margin-top: 2.5rem;">
      {subjects.map((s) => (
        <a href={href(`/subjects/${s.id}`)} class="subject-row">
          <span class="num">{String(s.data.order).padStart(2, '0')}</span>

          <div class="subject-media" aria-hidden="true">
            <img
              src={`https://picsum.photos/seed/${s.id}/640/400`}
              alt=""
              loading="lazy"
              decoding="async"
              width="640"
              height="400"
              class="subject-image"
            />
          </div>

          <div class="subject-copy">
            <h3>{s.data.title}</h3>
            <p class="tagline">{s.data.tagline}</p>
          </div>

          <div class="who">
            {tutorsFor(s.id).map((t) => (
              t.data.photo ? (
                <img
                  src={t.data.photo}
                  alt={t.data.name}
                  class="avatar avatar-sm"
                  title={t.data.name}
                  loading="lazy"
                />
              ) : (
                <span class={`avatar avatar-sm ac-${t.data.accent}`} title={t.data.name}>
                  {t.data.name.charAt(0)}
                </span>
              )
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .subject-row {
    display: grid;
    grid-template-columns: auto 128px minmax(0, 1fr) auto;
    grid-template-areas: "num media copy who";
    gap: 1.6rem;
    padding-block: 1.2rem;
    align-items: center;
  }

  .subject-row .num,
  .subject-media,
  .subject-copy,
  .subject-row .who {
    min-width: 0;
  }

  .subject-row .num {
    grid-area: num;
  }

  .subject-media {
    grid-area: media;
  }

  .subject-copy {
    grid-area: copy;
  }

  .subject-row .who {
    grid-area: who;
    justify-self: end;
  }

  .subject-media {
    width: 128px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: calc(var(--radius) - 2px);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--border) 25%, transparent);
  }

  .subject-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .subject-row:hover .subject-image {
    transform: scale(1.03);
  }

  .subject-copy {
    display: block;
  }

  .subject-copy h3 {
    overflow-wrap: break-word;
  }

  @media (max-width: 800px) {
    .subject-row {
      grid-template-columns: auto 96px minmax(0, 1fr);
      grid-template-areas:
        "num media copy"
        ". . who";
      gap: 1rem;
      row-gap: 0.75rem;
    }

    .subject-media {
      width: 96px;
    }

    .subject-row .num {
      font-size: 2rem;
    }

    .subject-row .who {
      grid-column: auto;
      margin-top: 0;
      justify-self: start;
    }
  }

  @media (max-width: 520px) {
    .subject-row {
      grid-template-columns: auto 72px minmax(0, 1fr);
      gap: 0.9rem;
    }

    .subject-media {
      width: 72px;
    }

    .subject-row h3 {
      font-size: 1.2rem;
    }

    .subject-row .tagline {
      font-size: 0.92rem;
    }
  }
</style>