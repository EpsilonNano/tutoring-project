---
import Layout from '../layouts/Layout.astro'
---
<Layout title="Contact · Brantford Tutors" description="Message us about tutoring. One of the three of us replies within a day.">
  <section class="container">
    <p class="section-label">Contact</p>
    <h1>Talk to a human, not a bot.</h1>
    <p class="lead" style="margin-top: 1rem;">
      Send a message and one of the three of us will reply within a day. Usually much faster.
    </p>

    <div class="split" style="margin-top: 2.5rem;">
        <div class="form-slot">
          <iframe src="https://docs.google.com/forms/d/e/1FAIpQLSeaFV3OPxofTejjmgSgY0qFtGG8Rx0bWGwS0Qnj7Lx43cPBZQ/viewform?embedded=true" width="640" height="851" frameborder="0" marginheight="0" marginwidth="0">Loading…</iframe>
        </div>
      <aside>
        <p class="section-label">What happens next</p>
        <ol class="next-steps">
          <li><span class="step-num">1.</span><span>You send a message with your question or the subject you need.</span></li>
          <li><span class="step-num">2.</span><span>One of us replies within a day to answer or set up a time.</span></li>
          <li><span class="step-num">3.</span><span>We confirm the place, and you show up ready to work.</span></li>
        </ol>
        <div class="policy ac-sage" style="margin-top: 2rem;">
          <h3>Prefer email?</h3>
          <p>Reach us at <strong>tutors.brantford@gmail.com</strong>.</p>
        </div>
      </aside>
    </div>
  </section>
</Layout>
