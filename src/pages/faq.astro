---
import Layout from '../layouts/Layout.astro'
import { href } from '../lib/link'
const faqs = [
  { 
    q: 'Where do sessions happen?', 
    a: 'Usually at the St. Paul Brantford Public Library branch, at your house, or online over Google Meet. We confirm the exact spot when we confirm the booking.' 
  },
  { 
    q: 'How does payment work?', 
    a: 'Cash or e-Transfer at the session. Nothing charged online, no card needed. Your first session is half price.' 
  },
  { 
    q: 'What if I need to cancel?', 
    a: 'Give us 24-hour notice and it is free. Inside 24 hours or a no-show, we ask for half the session rate.' 
  },
  { 
    q: 'Do you tutor groups?', 
    a: 'Yes. Two or three friends can book one tutor together and split the cost. For anything bigger, just ask us first.' 
  },
  { 
    q: 'Which grades do you teach?', 
    a: 'From kindergarten through Grade 11 and some Grade 12 topics. If you are not sure, just message us.' 
  },
  { 
    q: 'Do parents need to stay?', 
    a: 'Up to you and your parents. A lot of students work fine on their own. Parents are always welcome to stay or check in at the end.' 
  },
  { 
    q: 'I am completely lost in class. Can you still help?', 
    a: 'Yes, that is pretty common. We start by finding the exact point where things stopped making sense and rebuild from there. Being behind is just the starting point.' 
  },
  { 
    q: 'Test prep or homework help?', 
    a: 'Both. Bring the homework you are stuck on, or bring a test date and we will build a review plan around it.' 
  },
  { 
    q: 'How fast do you confirm bookings?', 
    a: 'Within a day, usually faster. You get a text or email confirming the time and place.' 
  },
  { 
    q: 'Can I get the same tutor every week?', 
    a: 'Yes, and we prefer that. Consistency helps a lot. When you book, just mention that you want a standing weekly slot.' 
  },
  { 
    q: 'What should I bring?', 
    a: 'Your textbook or notes, a recent quiz or test if you have one, and the specific problem you are stuck on.' 
  },
]
---
<Layout title="FAQ · Brantford Tutors" description="Answers about our tutoring. Where we meet, how to pay, and what to bring.">
  <section class="container">
    <p class="section-label">FAQ</p>
    <h1>Common questions.</h1>

    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <div class="faq-body"><p>{f.a}</p></div>
        </details>
      ))}
    </div>

    <p style="margin-top: 3rem;">
      Still curious? <a href={href('/contact')}>Send us a message</a> and we will answer within a day.
    </p>
  </section>
</Layout>
