---
import Layout from '../layouts/Layout.astro'
---
<Layout title="Page not found · StudyHall">
  <section class="container notfound">
    <div class="big">4<span>0</span>4</div>
    <h1 style="margin-top: 1rem;">This page played hooky.</h1>
    <p class="lead" style="margin: 1rem auto 0;">
      The page you are looking for skipped class. Let us get you back somewhere useful.
    </p>
    <div class="hero-actions" style="justify-content: center; margin-top: 2rem;">
      <a href="/" class="btn">Back to Home</a>
      <a href="/book" class="btn btn-ghost">Book a Session</a>
    </div>
  </section>
</Layout>