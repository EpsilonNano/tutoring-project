---
import Layout from '../../layouts/Layout.astro'
import { getCollection, render } from 'astro:content'
import { href } from '../../lib/link'

export async function getStaticPaths() {
  const tutors = await getCollection('tutors')
  return tutors.map((t) => ({ params: { slug: t.id }, props: { tutor: t } }))
}

const { tutor } = Astro.props
const { Content } = await render(tutor)

const others = (await getCollection('tutors'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((t) => t.id !== tutor.id)
---
<Layout title={`${tutor.data.name}, Tutor · Brantford Tutors`}>
  <section class="container">
    <a href={href('/tutors')} class="back-link">← All tutors</a>

    <div class={`profile-head ac-${tutor.data.accent}`}>
      {tutor.data.photo ? (
        <img src={tutor.data.photo} alt={tutor.data.name} class="avatar avatar-lg" loading="lazy" />
      ) : (
        <div class="avatar avatar-lg">{tutor.data.name.charAt(0)}</div>
      )}
      <div>
        <h1>{tutor.data.name}</h1>
        <p class="meta">{tutor.data.grade} · <strong>{tutor.data.average} average</strong></p>
      </div>
    </div>

    <div class="chips" style="margin-top: 1.4rem;">
      {tutor.data.specialties.map((sp) => <span class="chip">{sp}</span>)}
    </div>

    <div class="prose" style="margin-top: 2rem;">
      <Content />
    </div>

    <div style="margin-top: 2rem;">
      <p class="section-label">Also available</p>
      <div class="mini-tutors">
        {others.map((t) => (
          <a href={href(`/tutors/${t.id}`)} class={`mini-tutor ac-${t.data.accent}`}>
            {t.data.photo ? (
              <img src={t.data.photo} alt={t.data.name} class="avatar avatar-sm" loading="lazy" />
            ) : (
              <div class="avatar avatar-sm">{t.data.name.charAt(0)}</div>
            )}
            <div>
              <strong>{t.data.name}</strong>
              <p class="meta">{t.data.blurb}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>