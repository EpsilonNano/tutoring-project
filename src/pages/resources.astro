---
import Layout from '../layouts/Layout.astro'
import { href } from '../lib/link'
const sections = [
  { id: 'math', label: 'Math' },
  { id: 'science', label: 'Science' },
  { id: 'french', label: 'French' },
  { id: 'coding', label: 'Coding' },
  { id: 'chess', label: 'Chess' },
  { id: 'study', label: 'Study techniques' },
]
---
<Layout title="Free Resources · Brantford Tutors" description="The free tools and sites we actually use to study, for math, science, French, coding, chess, and study skills.">
  <section class="container">
    <p class="section-label">Resources</p>
    <h1>Helpful free tools.</h1>
    <p class="lead" style="margin-top: 1rem;">
      Everything here is free and has earned its place.
    </p>

    <a href={href('/math-test')} class="math-test-banner">
      <div class="math-test-banner-text">
        <span class="math-test-badge">Free · 10-15 min</span>
        <strong>Not sure where you stand in math?</strong>
        <span>Answer 12 questions and see what to review next.</span>
      </div>
      <span class="math-test-cta">Take the free check</span>
    </a>

    <nav class="anchor-nav">
      {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
    </nav>

    <div class="resource-section" id="math">
      <h2>Math</h2>
      <div class="resource-list">
        <a class="resource-link" href="https://www.khanacademy.org" target="_blank" rel="noopener">
          <span class="r-name">Khan Academy</span><span class="r-desc">We send this when you need a full lesson from the start.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://www.desmos.com" target="_blank" rel="noopener">
          <span class="r-name">Desmos</span><span class="r-desc">We open this in sessions to see what a graph really does.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://www.wolframalpha.com" target="_blank" rel="noopener">
          <span class="r-name">Wolfram Alpha</span><span class="r-desc">We use it to check steps after you try first.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://tutorial.math.lamar.edu" target="_blank" rel="noopener">
          <span class="r-name">Paul's Online Math Notes</span><span class="r-desc">We print examples from here for extra practice.</span><span class="r-arrow">↗</span>
        </a>
      </div>
    </div>

    <div class="resource-section" id="science">
      <h2>Science</h2>
      <div class="resource-list">
        <a class="resource-link" href="https://phet.colorado.edu" target="_blank" rel="noopener">
          <span class="r-name">PhET Simulations</span><span class="r-desc">We play with these when a concept is hard to picture.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://www.khanacademy.org/science" target="_blank" rel="noopener">
          <span class="r-name">Khan Academy Science</span><span class="r-desc">We assign one video here before a review session.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://chem.libretexts.org" target="_blank" rel="noopener">
          <span class="r-name">LibreTexts Chemistry</span><span class="r-desc">Our backup chem text when class notes are thin.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://www.youtube.com/@crashcourse" target="_blank" rel="noopener">
          <span class="r-name">Crash Course</span><span class="r-desc">We watch these for the big picture first.</span><span class="r-arrow">↗</span>
        </a>
      </div>
    </div>

    <div class="resource-section" id="french">
      <h2>French</h2>
      <div class="resource-list">
        <a class="resource-link" href="https://www.wordreference.com" target="_blank" rel="noopener">
          <span class="r-name">WordReference</span><span class="r-desc">Our dictionary. The forums explain tricky phrasing.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://www.lawlessfrench.com" target="_blank" rel="noopener">
          <span class="r-name">Lawless French</span><span class="r-desc">We send one page from here when a tense slips.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://apprendre.tv5monde.com" target="_blank" rel="noopener">
          <span class="r-name">TV5MONDE</span><span class="r-desc">We pick a short video so you hear real French.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://francais.lingolia.com" target="_blank" rel="noopener">
          <span class="r-name">Lingolia French</span><span class="r-desc">Quick check for verb forms before a quiz.</span><span class="r-arrow">↗</span>
        </a>
      </div>
    </div>

    <div class="resource-section" id="coding">
      <h2>Coding</h2>
      <div class="resource-list">
        <a class="resource-link" href="https://www.freecodecamp.org" target="_blank" rel="noopener">
          <span class="r-name">freeCodeCamp</span><span class="r-desc">We start here if you want extra practice between sessions.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://cs50.harvard.edu" target="_blank" rel="noopener">
          <span class="r-name">CS50</span><span class="r-desc">Watch week zero if you want to see what coding can be.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://docs.python.org/3/tutorial" target="_blank" rel="noopener">
          <span class="r-name">Python Tutorial</span><span class="r-desc">We read this together when docs feel scary.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://exercism.org" target="_blank" rel="noopener">
          <span class="r-name">Exercism</span><span class="r-desc">Small tasks here with feedback from real people.</span><span class="r-arrow">↗</span>
        </a>
      </div>
    </div>

    <div class="resource-section" id="chess">
      <h2>Chess</h2>
      <div class="resource-list">
        <a class="resource-link" href="https://lichess.org" target="_blank" rel="noopener">
          <span class="r-name">Lichess</span><span class="r-desc">We play here. Free and easy to start.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://lichess.org/training" target="_blank" rel="noopener">
          <span class="r-name">Lichess Puzzles</span><span class="r-desc">We do five of these as a warm-up.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://www.chess.com/lessons" target="_blank" rel="noopener">
          <span class="r-name">Chess.com Lessons</span><span class="r-desc">Good videos. Some cost extra.</span><span class="r-arrow">↗</span>
        </a>
      </div>
    </div>

    <div class="resource-section" id="study">
      <h2>Study techniques</h2>
      <p style="margin-top: .8rem; color: var(--muted); max-width: 65ch;">
        Three things that work in our own classes. Quiz yourself, space out review, and do past questions.
      </p>
      <div class="resource-list">
        <a class="resource-link" href="https://apps.ankiweb.net" target="_blank" rel="noopener">
          <span class="r-name">Anki</span><span class="r-desc">We make cards here for vocab and formulas.</span><span class="r-arrow">↗</span>
        </a>
        <a class="resource-link" href="https://pomofocus.io" target="_blank" rel="noopener">
          <span class="r-name">Pomofocus</span><span class="r-desc">We use 25 min on, 5 min off in long sessions.</span><span class="r-arrow">↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
