---
import Layout from '../layouts/Layout.astro'
import { href } from '../lib/link'
---
<Layout title="Pricing · Brantford Tutors" description="Simple cash pricing for one-on-one and small group tutoring. No online fees, no card on file.">
  <section class="container">
    <p class="section-label">Pricing</p>
    <h1>Keeping it simple and affordable.</h1>
    <p class="lead" style="margin-top: 1rem;">
      We’re students too. You pay at the session with cash or e-Transfer.
    </p>

    <!-- First session half‑price callout -->
    <div class="callout" style="margin-top: 2rem;">
      <span class="callout-num">50%</span>
      <p><strong>Your first session is half price.</strong> Try us out. If it is not a fit, it barely cost you anything.</p>
    </div>

    <!-- Pricing cards -->
    <div class="pricing-grid">
      <div class="pricing-card">
        <h3 class="plan-name">Small Group</h3>
        <div class="plan-price">$15<small>/hr per person</small></div>
        <div class="plan-desc">Great budget option for friends studying together.</div>
        <a href={href('/book')} class="btn plan-btn" style="margin-bottom: 1rem;">Book Now</a>
        <ul class="plan-features" style="margin-top: auto;">
          <li>Any subject</li>
          <li>Flexible scheduling</li>
          <li>No online fees</li>
          <li>Group study setup (2–3 students)</li>
        </ul>
      </div>

      <div class="pricing-card" style="display: flex; flex-direction: column; height: 100%;">
        <h3 class="plan-name">1‑on‑1 Hour</h3>
        <div class="plan-price">$25<small>/hr</small></div>
        <div class="plan-desc">Dedicated, individual attention focused entirely on you.</div>
        <a href={href('/book')} class="btn plan-btn" style="margin-bottom: 1rem;">Book Now</a>
        <ul class="plan-features" style="margin-top: auto;">
          <li>Any subject</li>
          <li>Flexible scheduling</li>
          <li>No online fees</li>
          <li>100% solo focus (1-on-1)</li>
          <li>Customized lesson pacing</li>
        </ul>
      </div>

      <div class="pricing-card featured" style="display: flex; flex-direction: column; height: 100%;">
        <span class="popular-badge">Most popular</span>
        <h3 class="plan-name">1‑on‑1 Extended</h3>
        <div class="plan-price">$35<small>/90 min</small></div>
        <div class="plan-desc">Extended time for deep understanding and major exam prep.</div>
        <a href={href('/book')} class="btn plan-btn" style="margin-bottom: 1rem;">Book Now</a>
        <ul class="plan-features" style="margin-top: auto;">
          <li>Any subject</li>
          <li>Flexible scheduling</li>
          <li>No online fees</li>
          <li>100% solo focus (1-on-1)</li>
          <li>Customized lesson pacing</li>
          <li>Full 90-minute extended session</li>
          <li>In-depth test & exam review</li>
          <li>Complex topic masterclass</li>
        </ul>
      </div>
    </div>

    <!-- Cancellations -->
    <div class="cancellation-section" style="margin-top: 3rem;">
      <h2>Cancellations</h2>
      <p class="lead" style="margin-top: 0.5rem;">
        Need to reschedule? Give us at least 24 hours' notice and you won't be charged a thing. Cancellations within 24 hours or no-shows are billed at 50% of the session rate. Just text or email us as soon as your plans change!
      </p>
    </div>

    <div style="margin-top: 3rem;">
      <a href={href('/book')} class="btn">Book a Session</a>
      <a href={href('/faq')} class="btn btn-ghost" style="margin-left: .8rem;">Read the FAQ</a>
    </div>
  </section>
</Layout>