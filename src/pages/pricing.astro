---
import Layout from '../layouts/Layout.astro'
import { href } from '../lib/link'
---
<Layout title="Pricing · Brantford Tutors" description="Simple pricing for private and small group tutoring. Pay at the session. No card on file.">
  <section class="container">
    <p class="section-label">Pricing</p>
    <h1>Simple and affordable.</h1>
    <p class="lead" style="margin-top: 1rem;">
      Pay at the session with cash or e-Transfer.
    </p>

    <!-- First session callout -->
    <div class="callout" style="margin-top: 2rem;">
      <span class="callout-num">50%</span>
      <p><strong>Your first session is half price.</strong> Try us out. If it is not a fit, it barely cost you anything.</p>
    </div>

    <!-- Pricing cards -->
    <div class="pricing-grid">
      <div class="pricing-card">
        <h3 class="plan-name">Small Group</h3>
        <div class="plan-price">$15<small>/hr per person</small></div>
        <div class="plan-desc">For 2 to 3 friends in one session.</div>
        <a href={href('/book')} class="btn plan-btn" style="margin-bottom: 1rem;">Book Now</a>
        <ul class="plan-features" style="margin-top: auto;">
          <li>Any subject</li>
          <li>You pick the time</li>
          <li>Pay at the session</li>
          <li>Same price for each student</li>
        </ul>
      </div>

      <div class="pricing-card" style="display: flex; flex-direction: column; height: 100%;">
        <h3 class="plan-name">Private Hour</h3>
        <div class="plan-price">$25<small>/hr</small></div>
        <div class="plan-desc">One student. We work on what you bring.</div>
        <a href={href('/book')} class="btn plan-btn" style="margin-bottom: 1rem;">Book Now</a>
        <ul class="plan-features" style="margin-top: auto;">
          <li>Any subject</li>
          <li>You pick the time</li>
          <li>Pay at the session</li>
          <li>Full attention on you</li>
          <li>Good for weekly help</li>
        </ul>
      </div>

      <div class="pricing-card featured" style="display: flex; flex-direction: column; height: 100%;">
        <span class="popular-badge">Popular for exam weeks</span>
        <h3 class="plan-name">Private 90 min</h3>
        <div class="plan-price">$35<small>/90 min</small></div>
        <div class="plan-desc">One student. More time for tests and review.</div>
        <a href={href('/book')} class="btn plan-btn" style="margin-bottom: 1rem;">Book Now</a>
        <ul class="plan-features" style="margin-top: auto;">
          <li>Any subject</li>
          <li>You pick the time</li>
          <li>Pay at the session</li>
          <li>Full attention on you</li>
          <li>Good for exam weeks</li>
          <li>Time for past questions</li>
        </ul>
      </div>
    </div>

    <!-- Cancellations -->
    <div class="cancellation-section" style="margin-top: 3rem;">
      <h2>Cancellations</h2>
      <p class="lead" style="margin-top: 0.5rem;">
        Need a new time? Give us at least 24-hour notice and you pay nothing. Late cancel or no-show is half the session rate. Text or email us as soon as plans change.
      </p>
    </div>

    <div style="margin-top: 3rem;">
      <a href={href('/book')} class="btn">Book a Session</a>
      <a href={href('/faq')} class="btn btn-ghost" style="margin-left: .8rem;">Read the FAQ</a>
    </div>
  </section>
</Layout>