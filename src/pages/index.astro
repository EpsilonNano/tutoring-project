---
import Layout from '../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { href } from '../lib/link'

const subjects = (await getCollection('subjects')).sort((a, b) => a.data.order - b.data.order)
const tutors = await getCollection('tutors')
---
<Layout title="Brantford Tutors · Peer Tutoring by Students">
  <section class="hero container">
    <div class="hero-grid">
      <div class="hero-text">
        <h1>We’re three Grade 12 students in Brantford who are passionate about tutoring.</h1>
        <p class="lead">
          We’re three Grade 12 students in Brantford. We tutor the subjects we just finished — math, science, French, coding, and chess — and we try to explain them the way that actually made them click for us.
        </p>
        <div class="hero-actions">
          <a href={href('/book')} class="btn">Book a Session</a>
          <a href={href('/tutors')} class="btn btn-ghost">Meet the Tutors</a>
        </div>
      </div>
      <div class="hero-photos" aria-hidden="true">
        <div class="photo-cluster">
          {tutors.map((t) => (
            <div class="photo-orbit">
              <div class="photo-orbit-inner">
                <img
                  src={t.data.photo}
                  alt=""
                  class="hero-avatar"
                  loading="eager"
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="container">
    <p class="section-label">What we teach</p>
    <h2>Five subjects, one table.</h2>
    <div class="card-grid" style="margin-top: 1.5rem;">
      {subjects.map((s) => (
        <a href={href(`/subjects/${s.id}`)} class="card">
          <span class="card-num">{String(s.data.order).padStart(2, '0')}</span>
          <h3>{s.data.title}</h3>
          <p>{s.data.tagline}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
