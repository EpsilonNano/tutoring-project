---
import Layout from '../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { href } from '../lib/link'

const tutors = (await getCollection('tutors')).sort((a, b) => a.data.order - b.data.order)

const steps = [
  {
    n: '01',
    title: 'Book online',
    text: 'Pick a subject, a day, and a tutor in about a minute. We confirm by text or email within a day.',
  },
  {
    n: '02',
    title: 'Meet and learn',
    text: 'Sessions happen at the St. Paul library branch, at your home, or online over Google Meet.',
  },
  {
    n: '03',
    title: 'Pay at the session',
    text: 'Cash or e-Transfer when you are done. No card on file, and your first session is half price.',
  },
]

const howWeTeach = [
  {
    title: 'Find the stuck spot',
    text: 'We start where it stopped making sense and work forward with your homework.',
  },
  {
    title: 'Ask anything',
    text: 'No rushing. If the first explanation did not land we try a second way.',
  },
  {
    title: 'Practice for the test',
    text: 'We do similar problems and past test style questions so you walk in ready.',
  },
]

const rates = [
  { name: 'Small Group', desc: '2 to 3 friends learning together', price: '$15', per: '/hr per person' },
  { name: 'Private Hour', desc: 'One student, any subject', price: '$25', per: '/hr' },
  { name: 'Private 90 min', desc: 'More time for review and exam prep', price: '$35', per: '/90 min' },
]

const faqTeaser = [
  {
    q: 'Where do sessions happen?',
    a: 'Usually at the St. Paul Brantford Public Library branch, at your house, or online over Google Meet.',
  },
  {
    q: 'How does payment work?',
    a: 'Cash or e-Transfer at the session. Nothing charged online, no card needed. Your first session is half price.',
  },
  {
    q: 'What if I need to cancel?',
    a: 'Give us 24-hour notice and it is free. Inside 24 hours or a no-show, we ask for half the session rate.',
  },
]
---

<Layout title="Brantford Tutors · Peer Tutoring by Students">
  <section class="hero container">
    <div class="hero-grid">
      <div class="hero-text">
        <h1>Tutoring from students, for students.</h1>
        <p class="lead">
          We offer affordable tutoring from Kindergarten through Grade 11 in math, science, French, coding, and chess.
        </p>
        <div class="hero-actions">
          <a href={href('/book')} class="btn">Book a Session</a>
          <a href={href('/tutors')} class="btn btn-ghost">Meet the Tutors</a>
        </div>
      </div>

      <div class="hero-photos" aria-hidden="true">
        {tutors.map((t) => (
          <img
            src={t.data.photo}
            alt=""
            class="hero-avatar"
            loading="eager"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Free Math Test Callout -->
  <section class="container math-callout-section">
    <div class="card" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
      <div>
        <h3 style="margin: 0;">Not sure where you stand in math?</h3>
        <p style="margin: 0.25rem 0 0 0;">Answer 12 questions and see what to review next. Free, about 10-15 min.</p>
      </div>
      <a href={href('/math-test')} class="btn">Take the free check</a>
    </div>
  </section>

  <!-- How it works -->
  <section class="container">
    <h2>How it works</h2>

    <div class="card-grid">
      {steps.map((s) => (
        <div class="card">
          <span class="card-num">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Subjects -->
  <section class="container">
    <h2>Explore what we teach</h2>
    <p class="lead">Math, Science, French, Coding and Chess. See levels and what to bring for each one.</p>
    <p style="margin-top: 1rem;"><a href={href('/subjects')} class="text-link">See all subjects</a></p>
  </section>

  <!-- Tutors preview -->
  <section class="container">
    <h2>Meet the tutors</h2>

    <div class="tutor-panels">
      {tutors.map((t) => (
        <a href={href(`/tutors/${t.id}`)} class={`tutor-panel ac-${t.data.accent}`}>
          {t.data.photo ? (
            <img src={t.data.photo} alt={t.data.name} class="avatar" loading="lazy" />
          ) : (
            <div class="avatar">{t.data.name.charAt(0)}</div>
          )}
          <div>
            <h3>{t.data.name}</h3>
            <p class="meta">{t.data.grade} · <strong>{t.data.average} average</strong></p>
            <p style="margin-top: .6rem;">{t.data.blurb}</p>
          </div>
        </a>
      ))}
    </div>

    <p style="margin-top: 1rem;"><a href={href('/tutors')} class="text-link">See tutor profiles</a></p>
  </section>

  <!-- How we teach -->
  <section class="container">
    <h2>How we teach</h2>

    <div class="quotes">
      {howWeTeach.map((t) => (
        <div class="quote-card">
          <h3>{t.title}</h3>
          <p>{t.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Pricing + FAQ teaser -->
  <section class="container">
    <h2>Good to know</h2>

    <div class="split">
      <div>
        <h3 style="margin-bottom: .4rem;">Session rates</h3>

        <div class="rate-card" style="margin-top: 1rem;">
          {rates.map((r) => (
            <div class="rate-row">
              <div>
                <span class="rate-name">{r.name}</span>
                <span class="rate-desc">{r.desc}</span>
              </div>
              <span class="rate-dots"></span>
              <span class="rate-price">{r.price}<small>{r.per}</small></span>
            </div>
          ))}
        </div>

        <p style="margin-top: 1rem;"><a href={href('/pricing')} class="text-link">See pricing</a></p>
      </div>

      <div>
        <h3 style="margin-bottom: .4rem;">Common questions</h3>

        <div class="faq-list" style="margin-top: 1rem;">
          {faqTeaser.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <div class="faq-body"><p>{f.a}</p></div>
            </details>
          ))}
        </div>

        <p style="margin-top: 1rem;"><a href={href('/faq')} class="text-link">See all questions</a></p>
      </div>
    </div>
  </section>

  <!-- Final CTA band -->
  <section class="cta-band">
    <div class="container">
      <h2>First session is half price.</h2>
      <p>Pick a subject and time. We confirm within a day. Pay in person at the session.</p>
      <a href={href('/book')} class="btn">Book a Session</a>
    </div>
  </section>
</Layout>

<style>
  .text-link {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .text-link:hover {
    color: var(--accent);
  }

  /* --- How we teach cards --- */
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.4rem;
    margin-top: 0;
  }

  .quote-card {
    background: var(--paper-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.7rem 1.6rem;
    box-shadow: var(--shadow);
    transition: transform .2s ease;
  }

  .quote-card:hover {
    transform: translateY(-3px);
  }

  .quote-card h3 {
    font-size: 1.1rem;
    margin: 0 0 0.4rem 0;
  }

  .quote-card p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  /* --- Closing band --- */
  .cta-band {
    background: var(--accent-dark);
    text-align: center;
    padding-block: 4.5rem;
  }

  .cta-band h2 {
    color: #fff;
  }

  .cta-band p {
    color: rgba(255, 255, 255, .78);
    font-size: 1.1rem;
    max-width: 46ch;
    margin: .7rem auto 1.8rem;
  }
</style>