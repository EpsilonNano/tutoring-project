---
import Layout from '../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { href } from '../lib/link'

const subjects = (await getCollection('subjects')).sort((a, b) => a.data.order - b.data.order)
const tutors = await getCollection('tutors')
---
<Layout title="Brantford Tutors · Peer Tutoring by Students">
  <section class="hero container">
    <h1>Helping Brantford students feel confident in the classroom.</h1>
    <p class="lead">
      We are Daniel, Ethan, and Liam, three local high school students offering affordable,
      in-person and online tutoring. We help students understand the material not just memorizing it.
    </p>
    <div class="hero-actions">
      <a href={href('/book')} class="btn">Book a Session</a>
      <a href={href('/tutors')} class="btn btn-ghost">Meet the Tutors</a>
    </div>

    <div class="stat-strip">
      <div class="stat"><div class="stat-num">{tutors.length}</div><div class="stat-label">Tutors</div></div>
      <div class="stat"><div class="stat-num">{subjects.length}</div><div class="stat-label">Subjects</div></div>
      <div class="stat"><div class="stat-num">97%+</div><div class="stat-label">Our Average</div></div>
      <div class="stat"><div class="stat-num">$0</div><div class="stat-label">Online fees</div></div>
    </div>
  </section>

  <section class="container">
    <p class="section-label">What we teach</p>
    <h2>Five subjects, one table.</h2>
    <div class="card-grid" style="margin-top: 1.5rem;">
      {subjects.map((s) => (
        <a href={href(`/subjects/${s.id}`)} class="card">
          <span class="card-num">{String(s.data.order).padStart(2, '0')}</span>
          <h3>{s.data.title}</h3>
          <p>{s.data.tagline}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
