---
import Layout from "../layouts/Layout.astro";
// Note: Adjust the Layout path based on your exact repo structure.
---

<Layout 
  title="Free Math Readiness Test | Brantford Tutors" 
  description="Take our free 10–15 minute math readiness test for Grades 1–12. Find out which math skills are strong, which need review, and how prepared you are for the upcoming school year."
>
  <main class="max-w-3xl mx-auto px-4 py-12 md:py-20 min-h-[70vh]">
    
    <!-- STATE 1: Introduction -->
    <div id="view-intro" class="text-center space-y-8 animate-fade-in">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900">How ready are you for next year's math?</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">Take our free 10–15 minute assessment to find out what you're ready for — and what might be worth reviewing before school starts.</p>
      
      <div class="grid md:grid-cols-3 gap-6 my-10 text-left">
        <div class="p-6 bg-gray-50 rounded-xl">
          <h3 class="font-bold text-lg mb-2">⏱ 10–15 minutes</h3>
          <p class="text-gray-600 text-sm">A short assessment designed to respect your time.</p>
        </div>
        <div class="p-6 bg-gray-50 rounded-xl">
          <h3 class="font-bold text-lg mb-2">🎓 Grades 1–12</h3>
          <p class="text-gray-600 text-sm">Questions automatically adjust to your current grade level.</p>
        </div>
        <div class="p-6 bg-gray-50 rounded-xl">
          <h3 class="font-bold text-lg mb-2">📊 Useful results</h3>
          <p class="text-gray-600 text-sm">See which areas you're strongest in and which ones need review.</p>
        </div>
      </div>
      
      <button id="btn-start" class="px-8 py-4 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 transition-colors text-lg">
        Start the Test
      </button>
    </div>

    <!-- STATE 2: Grade Selection -->
    <div id="view-grade" class="hidden animate-fade-in max-w-xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-8">What grade are you entering?</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4" id="grade-grid">
        <!-- Generated by JS -->
      </div>
    </div>

    <!-- STATE 3: Instructions -->
    <div id="view-instructions" class="hidden animate-fade-in max-w-xl mx-auto text-center space-y-8">
      <h2 class="text-3xl font-bold">A few things before you start</h2>
      <ul class="text-left space-y-4 text-lg text-gray-700 bg-gray-50 p-8 rounded-xl">
        <li class="flex gap-3"><span>✅</span> Take your time.</li>
        <li class="flex gap-3"><span>✅</span> Don't use outside help (no calculators for Grades 1-8).</li>
        <li class="flex gap-3"><span>✅</span> Most questions take less than a minute.</li>
        <li class="flex gap-3"><span>✅</span> Your results are an estimate based only on the skills tested.</li>
      </ul>
      <button id="btn-begin-test" class="px-8 py-4 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 transition-colors text-lg w-full">
        Begin →
      </button>
    </div>

    <!-- STATE 4: The Question UI -->
    <div id="view-question" class="hidden animate-fade-in max-w-2xl mx-auto">
      <div class="mb-8">
        <div class="flex justify-between text-sm font-bold text-gray-500 mb-2">
          <span id="question-counter">Question 1</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2">
          <div id="progress-bar" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>

      <div class="bg-white border-2 border-gray-100 shadow-sm rounded-2xl p-6 md:p-10 mb-6">
        <p id="question-text" class="text-2xl font-medium text-gray-900 mb-8" aria-live="polite"></p>
        
        <div id="options-container" class="space-y-3">
          <!-- Populated by JS -->
        </div>
      </div>

      <div class="flex justify-end">
        <button id="btn-next" class="px-8 py-3 bg-gray-300 text-gray-500 font-bold rounded-lg cursor-not-allowed transition-colors" disabled>
          Next →
        </button>
      </div>
    </div>

    <!-- STATE 5: Results -->
    <div id="view-results" class="hidden animate-fade-in space-y-12">
      <div class="text-center space-y-4">
        <h2 class="text-3xl font-bold text-gray-900">Your Math Readiness</h2>
        <div class="inline-block px-6 py-4 bg-blue-50 border border-blue-100 rounded-2xl">
          <p class="text-5xl font-extrabold text-blue-600 mb-2"><span id="result-score">0</span>% — <span id="result-readiness"></span></p>
          <p class="text-gray-600 font-medium">Estimated level: <span id="result-level" class="text-gray-900"></span></p>
        </div>
        <p class="text-xs text-gray-400 max-w-md mx-auto mt-4">This is an informal skills assessment, not an official school placement test. Your results are based only on the skills tested here.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white border-2 border-green-100 p-6 rounded-2xl shadow-sm">
          <h3 class="text-xl font-bold text-green-800 mb-4 flex items-center gap-2"><span>✓</span> Your strongest areas</h3>
          <ul id="list-strengths" class="space-y-2 text-gray-700"></ul>
        </div>
        <div class="bg-white border-2 border-amber-100 p-6 rounded-2xl shadow-sm">
          <h3 class="text-xl font-bold text-amber-800 mb-4 flex items-center gap-2"><span>△</span> Worth reviewing</h3>
          <ul id="list-review" class="space-y-2 text-gray-700"></ul>
        </div>
      </div>

      <div class="bg-gray-50 p-8 rounded-2xl text-center">
        <h3 class="text-2xl font-bold mb-4">Before school starts</h3>
        <p id="result-recommendation" class="text-lg text-gray-700 mb-8 max-w-2xl mx-auto"></p>
        
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href="/book" class="px-8 py-4 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 transition-colors">
            Book a Tutoring Session →
          </a>
          <button id="btn-retake" class="px-8 py-4 bg-white border-2 border-gray-200 text-gray-700 font-bold rounded-lg hover:bg-gray-50 transition-colors">
            Take the Test Again
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .animate-fade-in { animation: fadeIn 0.3s ease-out forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
  import { getNextQuestion, updateStateAfterAnswer, calculateResults, MAX_QUESTIONS, type TestState } from '../lib/mathTest';
  import type { MathQuestion } from '../data/mathTest';

  // State Management
  let state: TestState = {
    targetGrade: 0,
    currentDifficulty: 3,
    askedQuestionIds: [],
    responses: []
  };
  
  let currentQuestion: MathQuestion | null = null;
  let selectedOptionIndex: number | null = null;

  // DOM Elements
  const views = {
    intro: document.getElementById('view-intro'),
    grade: document.getElementById('view-grade'),
    instructions: document.getElementById('view-instructions'),
    question: document.getElementById('view-question'),
    results: document.getElementById('view-results')
  };

  const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
  const optionsContainer = document.getElementById('options-container');

  // Initialization
  document.addEventListener('DOMContentLoaded', () => {
    // Check for saved session
    const saved = sessionStorage.getItem('brantfordMathTestState');
    if (saved) {
      const parsed = JSON.parse(saved);
      if (parsed.askedQuestionIds.length > 0 && parsed.askedQuestionIds.length < MAX_QUESTIONS) {
        if(confirm("You have a test in progress. Would you like to continue?")) {
          state = parsed;
          loadNextQuestion();
          return;
        } else {
          sessionStorage.removeItem('brantfordMathTestState');
        }
      }
    }

    // Build Grade Grid
    const gradeGrid = document.getElementById('grade-grid');
    if(gradeGrid) {
      for (let i = 1; i <= 12; i++) {
        const btn = document.createElement('button');
        btn.className = "p-4 border-2 border-gray-200 rounded-xl hover:border-blue-500 hover:bg-blue-50 font-bold text-lg transition-colors";
        btn.innerText = `Grade ${i}`;
        btn.onclick = () => selectGrade(i);
        gradeGrid.appendChild(btn);
      }
    }
  });

  // Flow Control Functions
  function showView(viewName: keyof typeof views) {
    Object.values(views).forEach(v => v?.classList.add('hidden'));
    views[viewName]?.classList.remove('hidden');
    window.scrollTo(0, 0);
  }

  document.getElementById('btn-start')?.addEventListener('click', () => showView('grade'));

  function selectGrade(grade: number) {
    state.targetGrade = grade;
    state.currentDifficulty = 3; // Reset to baseline difficulty
    state.askedQuestionIds = [];
    state.responses = [];
    showView('instructions');
  }

  document.getElementById('btn-begin-test')?.addEventListener('click', () => {
    loadNextQuestion();
  });

  function loadNextQuestion() {
    currentQuestion = getNextQuestion(state);
    
    if (!currentQuestion) {
      finishTest();
      return;
    }

    selectedOptionIndex = null;
    showView('question');
    
    // Update UI
    const counter = document.getElementById('question-counter');
    const progressBar = document.getElementById('progress-bar');
    const questionText = document.getElementById('question-text');
    
    if (counter) counter.innerText = `Question ${state.askedQuestionIds.length + 1}`;
    if (progressBar) progressBar.style.width = `${((state.askedQuestionIds.length) / MAX_QUESTIONS) * 100}%`;
    if (questionText) questionText.innerHTML = currentQuestion.question; // allows basic HTML like x<sup>2</sup>

    // Render Options
    if (optionsContainer) {
      optionsContainer.innerHTML = '';
      currentQuestion.options.forEach((opt, index) => {
        const btn = document.createElement('button');
        btn.className = "w-full text-left p-4 border-2 border-gray-200 rounded-xl hover:border-blue-400 hover:bg-blue-50 text-lg transition-colors option-btn";
        btn.innerHTML = `<span class="font-bold mr-3 text-gray-400">${String.fromCharCode(65 + index)}.</span> ${opt}`;
        btn.onclick = () => selectOption(btn, index);
        optionsContainer.appendChild(btn);
      });
    }

    // Reset Next Button
    btnNext.disabled = true;
    btnNext.className = "px-8 py-3 bg-gray-300 text-gray-500 font-bold rounded-lg cursor-not-allowed transition-colors";
  }

  function selectOption(clickedBtn: HTMLButtonElement, index: number) {
    selectedOptionIndex = index;
    
    // Reset all buttons
    document.querySelectorAll('.option-btn').forEach(btn => {
      btn.classList.remove('border-blue-600', 'bg-blue-50');
      btn.classList.add('border-gray-200');
    });

    // Highlight selected
    clickedBtn.classList.remove('border-gray-200');
    clickedBtn.classList.add('border-blue-600', 'bg-blue-50');

    // Enable Next Button
    btnNext.disabled = false;
    btnNext.className = "px-8 py-3 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 transition-colors cursor-pointer";
  }

  btnNext.addEventListener('click', () => {
    if (selectedOptionIndex === null || !currentQuestion) return;

    const isCorrect = selectedOptionIndex === currentQuestion.correctAnswerIndex;
    state = updateStateAfterAnswer(state, currentQuestion, isCorrect);
    
    // Save progress
    sessionStorage.setItem('brantfordMathTestState', JSON.stringify(state));

    if (state.askedQuestionIds.length >= MAX_QUESTIONS) {
      finishTest();
    } else {
      loadNextQuestion();
    }
  });

  function finishTest() {
    sessionStorage.removeItem('brantfordMathTestState');
    const results = calculateResults(state);
    
    // Populate Results UI
    document.getElementById('result-score')!.innerText = results.overallScore.toString();
    document.getElementById('result-readiness')!.innerText = results.readiness;
    document.getElementById('result-level')!.innerText = results.estimatedLevel;

    // Strengths
    const ulStrengths = document.getElementById('list-strengths')!;
    ulStrengths.innerHTML = '';
    if(results.strengths.length > 0) {
      results.strengths.forEach(s => ulStrengths.innerHTML += `<li>${s}</li>`);
    } else {
      ulStrengths.innerHTML = `<li class="text-gray-500 italic">No clear strengths identified in this short test.</li>`;
    }

    // Review Areas
    const ulReview = document.getElementById('list-review')!;
    ulReview.innerHTML = '';
    if(results.reviewAreas.length > 0) {
      results.reviewAreas.forEach(s => ulReview.innerHTML += `<li>${s}</li>`);
    } else {
      ulReview.innerHTML = `<li class="text-gray-500 italic">No significant gaps identified!</li>`;
    }

    // Recommendation Text
    const recText = document.getElementById('result-recommendation')!;
    if (results.overallScore >= 80) {
      recText.innerText = "You're in a good position for the upcoming year. A quick review before school starts should be enough to keep things fresh.";
    } else if (results.overallScore >= 60) {
      recText.innerText = "You understand many of the fundamentals, but reviewing the areas above before school starts would give you a stronger start.";
    } else {
      recText.innerText = "You have some important gaps worth addressing before the school year begins. Focusing on the areas above would be a good place to start.";
    }

    showView('results');
  }

  document.getElementById('btn-retake')?.addEventListener('click', () => {
    showView('intro');
  });
</script>
