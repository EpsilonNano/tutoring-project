---
import Layout from "../layouts/Layout.astro";
---

<Layout 
  title="Free Math Readiness Test | Brantford Tutors" 
  description="Take our free 10–15 minute math readiness test for Grades 1–12. Find out which math skills are strong, which need review, and how prepared you are for the upcoming school year."
>
  <main class="max-w-2xl mx-auto px-4 py-12 md:py-20 min-h-[70vh] flex flex-col justify-center">
    
    <!-- STATE 1: Introduction -->
    <div id="view-intro" class="text-center space-y-8 animate-fade-in bg-white border border-gray-100 shadow-sm rounded-2xl p-8 md:p-12">
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight">How ready are you for next year's math?</h1>
      <p class="text-lg text-gray-600 max-w-xl mx-auto leading-relaxed">Take our free 10–15 minute assessment to find out what you're ready for — and what might be worth reviewing before school starts.</p>
      
      <div class="grid sm:grid-cols-3 gap-4 my-8 text-left">
        <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
          <h3 class="font-bold text-base mb-1 text-gray-900">⏱ 10–15 mins</h3>
          <p class="text-gray-600 text-sm">Respects your time.</p>
        </div>
        <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
          <h3 class="font-bold text-base mb-1 text-gray-900">🎓 Grades 1–12</h3>
          <p class="text-gray-600 text-sm">Adjusts to your grade.</p>
        </div>
        <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
          <h3 class="font-bold text-base mb-1 text-gray-900">📊 Useful results</h3>
          <p class="text-gray-600 text-sm">Clear skill breakdown.</p>
        </div>
      </div>
      
      <button id="btn-start" class="w-full sm:w-auto px-8 py-4 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-colors text-lg shadow-sm">
        Start the Test
      </button>
    </div>

    <!-- STATE 2: Grade Selection -->
    <div id="view-grade" class="hidden animate-fade-in bg-white border border-gray-100 shadow-sm rounded-2xl p-8 md:p-12">
      <h2 class="text-2xl md:text-3xl font-extrabold text-center mb-6 text-gray-900">What grade are you entering?</h2>
      <p class="text-center text-gray-500 mb-8">Select your upcoming grade level to tailor the questions.</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="grade-grid">
        <!-- Generated by JS -->
      </div>
    </div>

    <!-- STATE 3: Instructions -->
    <div id="view-instructions" class="hidden animate-fade-in bg-white border border-gray-100 shadow-sm rounded-2xl p-8 md:p-12 text-center space-y-6">
      <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900">A few things before you start</h2>
      <ul class="text-left space-y-3 text-base text-gray-700 bg-gray-50 p-6 rounded-xl border border-gray-100">
        <li class="flex gap-3 items-center"><span>✅</span> Take your time on each question.</li>
        <li class="flex gap-3 items-center"><span>✅</span> Don't use outside help or calculators (Grades 1–8).</li>
        <li class="flex gap-3 items-center"><span>✅</span> Most questions take under a minute.</li>
        <li class="flex gap-3 items-center"><span>✅</span> Results are an informal estimate of skills tested.</li>
      </ul>
      <button id="btn-begin-test" class="w-full py-4 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-colors text-lg shadow-sm">
        Begin Assessment →
      </button>
    </div>

    <!-- STATE 4: The Question UI -->
    <div id="view-question" class="hidden animate-fade-in">
      <div class="mb-6">
        <div class="flex justify-between items-center text-sm font-bold text-gray-500 mb-2">
          <span id="question-counter">Question 1</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
          <div id="progress-bar" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>

      <div class="bg-white border border-gray-100 shadow-sm rounded-2xl p-6 md:p-10 mb-6">
        <p id="question-text" class="text-xl md:text-2xl font-semibold text-gray-900 mb-8 leading-snug" aria-live="polite"></p>
        
        <div id="options-container" class="space-y-3">
          <!-- Populated by JS -->
        </div>
      </div>

      <div class="flex justify-end">
        <button id="btn-next" class="w-full sm:w-auto px-8 py-3.5 bg-gray-200 text-gray-400 font-bold rounded-xl cursor-not-allowed transition-colors" disabled>
          Next Question →
        </button>
      </div>
    </div>

    <!-- STATE 5: Results -->
    <div id="view-results" class="hidden animate-fade-in space-y-8 bg-white border border-gray-100 shadow-sm rounded-2xl p-6 md:p-10">
      <div class="text-center space-y-3 border-b border-gray-100 pb-8">
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900">Your Math Readiness</h2>
        <div class="inline-block px-6 py-4 bg-blue-50 border border-blue-100 rounded-2xl mt-2">
          <p class="text-4xl md:text-5xl font-black text-blue-600 mb-1"><span id="result-score">0</span>% <span class="text-2xl font-bold text-blue-800">— <span id="result-readiness"></span></span></p>
          <p class="text-gray-600 font-medium text-sm md:text-base mt-2">Estimated level: <span id="result-level" class="text-gray-900 font-bold"></span></p>
        </div>
        <p class="text-xs text-gray-400 max-w-md mx-auto mt-3">This is an informal skills assessment, not an official school placement test. Your results are based only on the skills tested here.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="bg-emerald-50/50 border border-emerald-100 p-5 rounded-xl">
          <h3 class="text-lg font-bold text-emerald-800 mb-3 flex items-center gap-2"><span>✓</span> Your strongest areas</h3>
          <ul id="list-strengths" class="space-y-1.5 text-gray-700 text-sm"></ul>
        </div>
        <div class="bg-amber-50/50 border border-amber-100 p-5 rounded-xl">
          <h3 class="text-lg font-bold text-amber-800 mb-3 flex items-center gap-2"><span>△</span> Worth reviewing</h3>
          <ul id="list-review" class="space-y-1.5 text-gray-700 text-sm"></ul>
        </div>
      </div>

      <div class="bg-gray-50 p-6 rounded-xl border border-gray-100 text-center space-y-4">
        <h3 class="text-xl font-bold text-gray-900">Before school starts</h3>
        <p id="result-recommendation" class="text-base text-gray-700 max-w-xl mx-auto leading-relaxed"></p>
        
        <div class="flex flex-col sm:flex-row justify-center gap-3 pt-2">
          <a href="/book" class="px-6 py-3.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-colors shadow-sm text-center">
            Book a Tutoring Session →
          </a>
          <button id="btn-retake" class="px-6 py-3.5 bg-white border border-gray-200 text-gray-700 font-bold rounded-xl hover:bg-gray-50 transition-colors text-center">
            Take the Test Again
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .animate-fade-in { animation: fadeIn 0.25s ease-out forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  /* Option Feedback States */
  .option-btn.correct {
    background-color: #ecfdf5 !important;
    border-color: #10b981 !important;
    color: #065f46 !important;
  }

  .option-btn.incorrect {
    background-color: #fef2f2 !important;
    border-color: #ef4444 !important;
    color: #991b1b !important;
  }

  .option-btn:disabled {
    cursor: default;
  }
</style>

<script>
  import { getNextQuestion, updateStateAfterAnswer, calculateResults, MAX_QUESTIONS, type TestState } from '../lib/mathTest';
  import type { MathQuestion } from '../data/mathTest';

  let state: TestState = {
    targetGrade: 0,
    currentDifficulty: 3,
    askedQuestionIds: [],
    responses: []
  };
  
  let currentQuestion: MathQuestion | null = null;
  let selectedOptionIndex: number | null = null;
  let hasAnswered = false;

  const views = {
    intro: document.getElementById('view-intro'),
    grade: document.getElementById('view-grade'),
    instructions: document.getElementById('view-instructions'),
    question: document.getElementById('view-question'),
    results: document.getElementById('view-results')
  };

  const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
  const optionsContainer = document.getElementById('options-container');

  document.addEventListener('DOMContentLoaded', () => {
    const saved = sessionStorage.getItem('brantfordMathTestState');
    if (saved) {
      const parsed = JSON.parse(saved);
      if (parsed.askedQuestionIds && parsed.askedQuestionIds.length > 0 && parsed.askedQuestionIds.length < MAX_QUESTIONS) {
        if(confirm("You have a test in progress. Would you like to continue?")) {
          state = parsed;
          loadNextQuestion();
          return;
        } else {
          sessionStorage.removeItem('brantfordMathTestState');
        }
      }
    }

    const gradeGrid = document.getElementById('grade-grid');
    if(gradeGrid) {
      for (let i = 1; i <= 12; i++) {
        const btn = document.createElement('button');
        btn.className = "p-3.5 border border-gray-200 rounded-xl hover:border-blue-500 hover:bg-blue-50/50 font-bold text-base transition-colors bg-white text-gray-800 shadow-sm";
        btn.innerText = `Grade ${i}`;
        btn.onclick = () => selectGrade(i);
        gradeGrid.appendChild(btn);
      }
    }
  });

  function showView(viewName: keyof typeof views) {
    Object.values(views).forEach(v => v?.classList.add('hidden'));
    views[viewName]?.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  document.getElementById('btn-start')?.addEventListener('click', () => showView('grade'));

  function selectGrade(grade: number) {
    state.targetGrade = grade;
    state.currentDifficulty = 3;
    state.askedQuestionIds = [];
    state.responses = [];
    showView('instructions');
  }

  document.getElementById('btn-begin-test')?.addEventListener('click', () => {
    loadNextQuestion();
  });

  function loadNextQuestion() {
    currentQuestion = getNextQuestion(state);
    
    if (!currentQuestion) {
      finishTest();
      return;
    }

    selectedOptionIndex = null;
    hasAnswered = false;
    showView('question');
    
    const counter = document.getElementById('question-counter');
    const progressBar = document.getElementById('progress-bar');
    const questionText = document.getElementById('question-text');
    
    if (counter) counter.innerText = `Question ${state.askedQuestionIds.length + 1} of ${MAX_QUESTIONS}`;
    if (progressBar) progressBar.style.width = `${((state.askedQuestionIds.length) / MAX_QUESTIONS) * 100}%`;
    if (questionText) questionText.innerHTML = currentQuestion.question;

    if (optionsContainer) {
      optionsContainer.innerHTML = '';
      currentQuestion.options.forEach((opt, index) => {
        const btn = document.createElement('button');
        btn.className = "w-full text-left p-4 border border-gray-200 rounded-xl hover:border-blue-400 hover:bg-blue-50/50 text-base md:text-lg transition-colors option-btn bg-white shadow-sm flex items-center";
        btn.innerHTML = `<span class="font-bold mr-3 text-gray-400 w-6">${String.fromCharCode(65 + index)}.</span> <span class="flex-1">${opt}</span>`;
        btn.onclick = () => selectOption(btn, index);
        optionsContainer.appendChild(btn);
      });
    }

    btnNext.disabled = true;
    btnNext.className = "w-full sm:w-auto px-8 py-3.5 bg-gray-200 text-gray-400 font-bold rounded-xl cursor-not-allowed transition-colors";
  }

  function selectOption(clickedBtn: HTMLButtonElement, index: number) {
    if (hasAnswered || !currentQuestion) return;
    
    hasAnswered = true;
    selectedOptionIndex = index;
    const isCorrect = index === currentQuestion.correctAnswerIndex;

    const optionButtons = document.querySelectorAll('.option-btn') as NodeListOf<HTMLButtonElement>;
    optionButtons.forEach((btn, idx) => {
      btn.disabled = true;
      if (idx === currentQuestion!.correctAnswerIndex) {
        btn.classList.add('correct');
      } else if (idx === index && !isCorrect) {
        btn.classList.add('incorrect');
      }
    });

    btnNext.disabled = false;
    btnNext.className = "w-full sm:w-auto px-8 py-3.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-colors shadow-sm cursor-pointer";
  }

  btnNext.addEventListener('click', () => {
    if (selectedOptionIndex === null || !currentQuestion) return;

    const isCorrect = selectedOptionIndex === currentQuestion.correctAnswerIndex;
    state = updateStateAfterAnswer(state, currentQuestion, isCorrect);
    
    sessionStorage.setItem('brantfordMathTestState', JSON.stringify(state));

    if (state.askedQuestionIds.length >= MAX_QUESTIONS) {
      finishTest();
    } else {
      loadNextQuestion();
    }
  });

  function finishTest() {
    sessionStorage.removeItem('brantfordMathTestState');
    const results = calculateResults(state);
    
    document.getElementById('result-score')!.innerText = results.overallScore.toString();
    document.getElementById('result-readiness')!.innerText = results.readiness;
    document.getElementById('result-level')!.innerText = results.estimatedLevel;

    const ulStrengths = document.getElementById('list-strengths')!;
    ulStrengths.innerHTML = '';
    if(results.strengths.length > 0) {
      results.strengths.forEach(s => ulStrengths.innerHTML += `<li class="flex items-center gap-2"><span>•</span> ${s}</li>`);
    } else {
      ulStrengths.innerHTML = `<li class="text-gray-500 italic">Keep practicing to build distinct strengths!</li>`;
    }

    const ulReview = document.getElementById('list-review')!;
    ulReview.innerHTML = '';
    if(results.reviewAreas.length > 0) {
      results.reviewAreas.forEach(s => ulReview.innerHTML += `<li class="flex items-center gap-2"><span>•</span> ${s}</li>`);
    } else {
      ulReview.innerHTML = `<li class="text-gray-500 italic">No major review areas detected!</li>`;
    }

    const recText = document.getElementById('result-recommendation')!;
    if (results.overallScore >= 80) {
      recText.innerText = "You're in a great position for the upcoming year. A quick review before school starts should be enough to keep things fresh.";
    } else if (results.overallScore >= 60) {
      recText.innerText = "You understand many of the fundamentals, but reviewing the areas above before school starts would give you a stronger start.";
    } else {
      recText.innerText = "You have some important gaps worth addressing before the school year begins. Focusing on the areas above is a great place to start.";
    }

    showView('results');
  }

  document.getElementById('btn-retake')?.addEventListener('click', () => {
    showView('intro');
  });
</script>
