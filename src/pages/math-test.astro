---
import Layout from "../layouts/Layout.astro";
---

<Layout 
  title="Free Math Readiness Test | Brantford Tutors" 
  description="Take our free 10-15 minute math readiness test for Grades 1-12. Find out which math skills are strong, which need review, and how prepared you are for the upcoming school year."
>
  <main class="test-container">
    
    <!-- STATE 1: Introduction -->
    <div id="view-intro" class="test-view text-center">
      <div class="test-card">
        <h1 class="test-title">How ready are you for next year's math?</h1>
        <p class="test-subtitle">Take our free 10-15 minute assessment to find out what you're ready for, and what might be worth reviewing before school starts.</p>
        
        <div class="test-features">
          <div class="feature-box">
            <h3>10-15 mins</h3>
            <p>Get results quickly.</p>
          </div>
          <div class="feature-box">
            <h3>Grades 1-12</h3>
            <p>Adjusts to your grade.</p>
          </div>
          <div class="feature-box">
            <h3>Useful results</h3>
            <p>Clear skill breakdown.</p>
          </div>
        </div>
        
        <button id="btn-start" class="btn-primary btn-large">Start the Test</button>
      </div>
    </div>

    <!-- STATE 2: Grade Selection -->
    <div id="view-grade" class="test-view hidden">
      <div class="test-card text-center">
        <h2 class="test-heading">What grade are you entering?</h2>
        <p class="test-hint">Select your upcoming grade level to tailor the questions.</p>
        <div class="grade-grid" id="grade-grid">
          <!-- Generated by JS -->
        </div>
      </div>
    </div>

    <!-- STATE 3: Instructions -->
    <div id="view-instructions" class="test-view hidden">
      <div class="test-card text-center">
        <h2 class="test-heading">A few things before you start...</h2>
        <ul class="instruction-list">
          <li><span>•</span> Take your time on each question.</li>
          <li><span>•</span> Don't use outside help or calculators (Grades 1-8).</li>
          <li><span>•</span> Most questions take under a minute.</li>
          <li><span>•</span> Results are an informal estimate of skills tested.</li>
        </ul>
        <button id="btn-begin-test" class="btn-primary btn-large">Begin Assessment</button>
      </div>
    </div>

    <!-- STATE 4: The Question UI -->
    <div id="view-question" class="test-view hidden">
      <div class="question-header">
        <div class="question-counter">
          <span id="question-counter">Question 1</span>
        </div>
        <div class="progress-bar">
          <div id="progress-bar" class="progress-fill" style="width: 0%"></div>
        </div>
      </div>

      <div class="test-card question-card">
        <p id="question-text" class="question-text" aria-live="polite"></p>
        
        <div id="options-container" class="options-grid">
          <!-- Populated by JS -->
        </div>
      </div>

      <div class="next-wrapper">
        <button id="btn-next" class="btn-next" disabled>Next Question</button>
      </div>
    </div>

    <!-- STATE 5: Results -->
    <div id="view-results" class="test-view hidden">
      <div class="test-card results-card">
        <div class="results-header">
          <h2 class="test-heading">Your Math Readiness</h2>
          <div class="score-badge">
            <p class="score-number"><span id="result-score">0</span>% <span class="score-label">— <span id="result-readiness"></span></span></p>
            <p class="estimated-level">Estimated level: <span id="result-level" class="level-value"></span></p>
          </div>
          <p class="disclaimer">This is an informal skills assessment, not an official school placement test. Your results are based only on the skills tested here.</p>
        </div>

        <div class="results-grid">
          <div class="strengths-box">
            <h3>Your strongest areas</h3>
            <ul id="list-strengths"></ul>
          </div>
          <div class="review-box">
            <h3>Worth reviewing</h3>
            <ul id="list-review"></ul>
          </div>
        </div>

        <div class="recommendation-box">
          <h3>Before school starts</h3>
          <p id="result-recommendation" class="recommendation-text"></p>
          
          <div class="results-actions">
            <a href="/book" class="btn-primary btn-large">Book a Tutoring Session</a>
            <button id="btn-retake" class="btn-secondary">Take the Test Again</button>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<!-- ===== SCRIPT ===== -->
<script>
  import { getNextQuestion, updateStateAfterAnswer, calculateResults, MAX_QUESTIONS, type TestState } from '../lib/mathTest';
  import type { MathQuestion } from '../data/mathTest';

  let state: TestState = {
    targetGrade: 0,
    currentDifficulty: 3,
    askedQuestionIds: [],
    responses: []
  };
  
  let currentQuestion: MathQuestion | null = null;
  let selectedOptionIndex: number | null = null;
  let hasAnswered = false;
  let isLockedIn = false; // Tracks if "Check Answer" has been clicked

  const views = {
    intro: document.getElementById('view-intro'),
    grade: document.getElementById('view-grade'),
    instructions: document.getElementById('view-instructions'),
    question: document.getElementById('view-question'),
    results: document.getElementById('view-results')
  };

  const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
  const optionsContainer = document.getElementById('options-container');

  document.addEventListener('DOMContentLoaded', () => {
    const saved = sessionStorage.getItem('brantfordMathTestState');
    if (saved) {
      const parsed = JSON.parse(saved);
      if (parsed.askedQuestionIds && parsed.askedQuestionIds.length > 0 && parsed.askedQuestionIds.length < MAX_QUESTIONS) {
        if(confirm("You have a test in progress. Would you like to continue?")) {
          state = parsed;
          loadNextQuestion();
          return;
        } else {
          sessionStorage.removeItem('brantfordMathTestState');
        }
      }
    }

    const gradeGrid = document.getElementById('grade-grid');
    if(gradeGrid) {
      for (let i = 1; i <= 12; i++) {
        const btn = document.createElement('button');
        btn.innerText = `Grade ${i}`;
        btn.onclick = () => selectGrade(i);
        gradeGrid.appendChild(btn);
      }
    }
  });

  function showView(viewName: keyof typeof views) {
    Object.values(views).forEach(v => v?.classList.add('hidden'));
    views[viewName]?.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  document.getElementById('btn-start')?.addEventListener('click', () => showView('grade'));

  function selectGrade(grade: number) {
    state.targetGrade = grade;
    state.currentDifficulty = 3;
    state.askedQuestionIds = [];
    state.responses = [];
    showView('instructions');
  }

  document.getElementById('btn-begin-test')?.addEventListener('click', () => {
    loadNextQuestion();
  });

  function loadNextQuestion() {
    currentQuestion = getNextQuestion(state);
    
    if (!currentQuestion) {
      finishTest();
      return;
    }

    selectedOptionIndex = null;
    hasAnswered = false;
    isLockedIn = false; // Reset lock-in state
    showView('question');
    
    const counter = document.getElementById('question-counter');
    const progressBar = document.getElementById('progress-bar');
    const questionText = document.getElementById('question-text');
    
    if (counter) counter.innerText = `Question ${state.askedQuestionIds.length + 1} of ${MAX_QUESTIONS}`;
    if (progressBar) progressBar.style.width = `${((state.askedQuestionIds.length) / MAX_QUESTIONS) * 100}%`;
    if (questionText) questionText.innerHTML = currentQuestion.question;

    if (optionsContainer) {
      optionsContainer.innerHTML = '';
      currentQuestion.options.forEach((opt, index) => {
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.innerHTML = `<span class="option-letter">${String.fromCharCode(65 + index)}.</span><span class="option-text">${opt}</span>`;
        btn.onclick = () => selectOption(btn, index);
        optionsContainer.appendChild(btn);
      });
    }

    // Reset button to "Check Answer" state
    btnNext.innerText = "Check Answer";
    btnNext.disabled = true;
    btnNext.classList.remove('enabled');
  }

  function selectOption(clickedBtn: HTMLButtonElement, index: number) {
    if (isLockedIn || !currentQuestion) return; // Prevent changing after lock-in
    
    selectedOptionIndex = index;
    hasAnswered = true;

    // Highlight selected option, un-highlight others
    const optionButtons = document.querySelectorAll('.option-btn') as NodeListOf<HTMLButtonElement>;
    optionButtons.forEach((btn, idx) => {
      if (idx === index) {
        btn.classList.add('selected');
      } else {
        btn.classList.remove('selected');
      }
    });

    // Enable the "Check Answer" button
    btnNext.disabled = false;
    btnNext.classList.add('enabled');
  }

  btnNext.addEventListener('click', () => {
    if (selectedOptionIndex === null || !currentQuestion) return;

    // STEP 1: Lock in & reveal right/wrong feedback
    if (!isLockedIn) {
      isLockedIn = true;
      const isCorrect = selectedOptionIndex === currentQuestion.correctAnswerIndex;

      // Remove selection outline and reveal right/wrong styles
      const optionButtons = document.querySelectorAll('.option-btn') as NodeListOf<HTMLButtonElement>;
      optionButtons.forEach((btn, idx) => {
        btn.disabled = true;
        btn.classList.remove('selected');

        if (idx === currentQuestion!.correctAnswerIndex) {
          btn.classList.add('correct');
        } else {
          btn.classList.add('incorrect');
        }
      });

      // Save response to state
      state = updateStateAfterAnswer(state, currentQuestion, isCorrect);
      sessionStorage.setItem('brantfordMathTestState', JSON.stringify(state));

      // Update button to advance
      btnNext.innerText = "Next Question";
      return;
    }

    // STEP 2: Advance to next question or finish test
    if (state.askedQuestionIds.length >= MAX_QUESTIONS) {
      finishTest();
    } else {
      loadNextQuestion();
    }
  });

  function finishTest() {
    sessionStorage.removeItem('brantfordMathTestState');
    const results = calculateResults(state);
    
    document.getElementById('result-score')!.innerText = results.overallScore.toString();
    document.getElementById('result-readiness')!.innerText = results.readiness;
    document.getElementById('result-level')!.innerText = results.estimatedLevel;

    const ulStrengths = document.getElementById('list-strengths')!;
    ulStrengths.innerHTML = '';
    if(results.strengths.length > 0) {
      results.strengths.forEach(s => ulStrengths.innerHTML += `<li>${s}</li>`);
    } else {
      ulStrengths.innerHTML = `<li class="text-gray-500 italic">Keep practicing to build distinct strengths!</li>`;
    }

    const ulReview = document.getElementById('list-review')!;
    ulReview.innerHTML = '';
    if(results.reviewAreas.length > 0) {
      results.reviewAreas.forEach(s => ulReview.innerHTML += `<li>${s}</li>`);
    } else {
      ulReview.innerHTML = `<li class="text-gray-500 italic">No major review areas detected!</li>`;
    }

    const recText = document.getElementById('result-recommendation')!;
    if (results.overallScore >= 80) {
      recText.innerText = "You're in a great position for the upcoming year. A quick review before school starts should be enough to keep things fresh.";
    } else if (results.overallScore >= 60) {
      recText.innerText = "You understand many of the fundamentals, but reviewing the areas above before school starts would give you a stronger start.";
    } else {
      recText.innerText = "You have some important gaps worth addressing before the school year begins. Focusing on the areas above is a great place to start.";
    }

    showView('results');
  }

  document.getElementById('btn-retake')?.addEventListener('click', () => {
    showView('intro');
  });
</script>